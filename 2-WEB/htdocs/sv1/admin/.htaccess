Options -Indexes
DirectoryIndex index.php panel.php

<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

<FilesMatch "\.(bak|backup|old|orig|save|tmp|log|txt|sql|ini|env)(?:[-._].*)?$">
  Require all denied
</FilesMatch>

<FilesMatch "\.php\.(?:bak|backup|old|orig|save)(?:[-._].*)?$">
  Require all denied
</FilesMatch>
